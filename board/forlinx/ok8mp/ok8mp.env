/* SPDX-License-Identifier: GPL-2.0+ */

console=ttymxc1,115200
image=Image
fdtfile=DEFAULT_FDT_FILE
kernel_addr_r=CONFIG_SYS_LOAD_ADDR
fdt_addr_r=0x43000000
kernel_comp_addr_r=0x80000000
kernel_comp_size=0x04000000
bootm_size=0x10000000
mmcdev=1
emmc_dev=2
bootpart=1
rootpart=2
mmcboot=
	if mmc dev ${mmcdev} && mmc rescan; then
		if part uuid mmc ${mmcdev}:${rootpart} rootuuid; then
			if load mmc ${mmcdev}:${bootpart} ${kernel_addr_r} ${image} &&
			   load mmc ${mmcdev}:${bootpart} ${fdt_addr_r} ${fdtfile}; then
				setenv bootargs console=${console} root=PARTUUID=${rootuuid} rootwait rw;
				booti ${kernel_addr_r} - ${fdt_addr_r};
			fi;
		fi;
	fi
mmc_bootcmd=
	setenv mmcdev 1;
	run mmcboot;
	setenv mmcdev 2;
	run mmcboot
autoload=no
serverip=
nfsroot=
nfsopts=vers=4,tcp
netboot=
	if test -n "${serverip}" && test -n "${nfsroot}"; then
		setenv autoload no;
		if dhcp && tftp ${kernel_addr_r} ${image} && tftp ${fdt_addr_r} ${fdtfile}; then
			setenv bootargs console=${console} root=/dev/nfs rw ip=dhcp
				nfsroot=${serverip}:${nfsroot},${nfsopts};
			booti ${kernel_addr_r} - ${fdt_addr_r};
		fi;
	else
		echo Set serverip and nfsroot before running netboot;
	fi
